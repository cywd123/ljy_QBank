  "mode": "单选题-A1型题",
  "test": "下列属于心脏压塞体征的是",
  "option": [
    "A. 心音增强",
    "B. 脉压变大",
    "C. 颈静脉怒张",
    "D. 心尖搏动增强",
    "E. 高血压"
  ],
  "answer": "C",
  "nine_point": "",
  "ten_point": "",
  "discuss": "心脏压塞时，心包腔内压力升高，阻碍静脉血回流到右心房，导致静脉系统淤血，从而出现颈静脉怒张（这是心脏压塞的重要体征之一）。同时患者还可能伴有奇脉、血压下降等表现（这些都与静脉回流受阻有关），因此颈静脉怒张是心脏压塞的典型体征（C对）。",
  "last_update": "2026-9-11"
}