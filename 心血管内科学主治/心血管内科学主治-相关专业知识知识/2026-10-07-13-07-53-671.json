  "unit": "5.胸腔积液",
  "mode": "单选题-A1型题",
  "test": "胸腔抽液每次（除首次外）不宜超过",
  "option": [
    "A. 0.5～1.0L",
    "B. 0.3～0.5L",
    "C. 0.5L以上",
    "D. 0.3L以下",
    "E. 1.0L"
