  "mode": "单选题-A1型题",
  "test": "HIV-1有多少种亚型",
  "option": [
    "A. 10",
    "B. 11",
    "C. 12",
    "D. 13",
    "E. 14"
  ],
  "answer": "D",
  "nine_point": "",
  "ten_point": "",
  "discuss": "HIV-1根据env基因核酸序列差异性可分为M、N、O三个亚型组。M亚型组包括A、B、C、D、E、F、G、H、I、J和K共11个亚型；N亚型组只有N亚型；O亚型组只有O亚型。因此，HIV-1共有13个亚型（D对）。",
  "last_update": "2026-5-6"
}