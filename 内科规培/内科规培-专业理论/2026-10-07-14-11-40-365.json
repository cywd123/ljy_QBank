  "test": "主动脉瓣轻度狭窄是",
  "option": [
    "A. ≥1.5cm²",
    "B. ＜1.0cm²",
    "C. ≥3.0cm²",
    "D. ＜0.5cm²",
    "E. ≥4.0cm²"
  ],
  "answer": "A",
  "nine_point": "",
  "ten_point": "",
  "discuss": "正常成人主动脉瓣口面积≥3.0cm²。当瓣口面积减小一半，即≥1.5cm²时，为轻度狭窄，收缩期无明显跨瓣压差，血流动力学改变不明显，患者通常无症状（A对）。随着瓣口面积进一步减小，狭窄程度加重，才会出现左心室排血受阻、左心室收缩压升高、跨瓣压差显著等明显临床表现和血流动力学异常。",
  "last_update": "2026-5-6"
}