  "unit": "6.心血管系统（心脏瓣膜病）",
  "mode": "单选题-B型题",
  "test": "主动脉瓣重度狭窄是",
  "option": [
    "A.＜1.5cm²",
    "B.＜1.0cm²",
    "C.≥3.0cm²",
    "D.＜0.5cm²",
    "E.≥4.0cm²"
  ],
  "answer": "B",
  "nine_point": "",
  "ten_point": "",
  "discuss": "主动脉瓣重度狭窄的诊断标准是瓣口面积≤1.0cm²（B对）。瓣口面积≤1.0cm²时，左心室排血明显受阻，收缩期压力阶差显著增加（可达50~100mmHg或更高），导致左心室壁向心性肥厚和舒张末压进行性升高，进而引起血流动力学改变，包括左心衰竭、心绞痛及晕厥等症状。",
  "last_update": "2026-3-10"
}