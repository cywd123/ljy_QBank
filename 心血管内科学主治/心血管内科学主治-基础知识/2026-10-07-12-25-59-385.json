  "test": "尿毒症患者口腔有",
  "option": [
    "A. 腥臭味",
    "B. 氨味",
    "C. 大蒜味",
    "D. 鼠尿味",
    "E. 烂苹果味"
  ],
  "answer": "B",
  "nine_point": "",
  "ten_point": "",
  "discuss": "尿毒症患者的口腔异味主要是由血液中的尿素氮通过唾液腺分泌到口腔中，在细菌作用下分解为氨气所致（B对）。腥臭味多见于肝性脑病或严重感染性疾病（A错）。大蒜味常见于有机磷中毒（C错）。鼠尿味见于苯丙酮尿症（D错）。烂苹果味是糖尿病酮症酸中毒的特征性气味（E错）。",
  "last_update": "2026-9-11"
}